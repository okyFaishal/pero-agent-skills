# ==============================================================================
# Pero Agent Skills - Templat Konfigurasi Kunci API MCP
# ==============================================================================
# Salin berkas ini menjadi '.env' di root proyek Anda:
#   cp .env.pero.example .env
#
# PERHATIAN: Berkas '.env' otomatis dilindungi oleh .gitignore dan skill
# 'env-guard' agar tidak pernah bocor ke commit git atau repositori publik.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Context7 Documentation API Key (Dokumentasi Resmi Framework & Library SDK)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'context-7', 'pero-system-architecture', 'pero-granular-refinement'.
# Peran SDLC: Rujukan garda kedua (Tier-2) untuk sintaks library dan API framework resmi.
# Kuota Gratis: 1.000 panggilan per bulan gratis (tanpa kartu kredit).
# Cara Mendapatkan:
#   1. Buka https://context7.com
#   2. Sign In dengan akun GitHub / Google
#   3. Masuk ke Dashboard -> API Keys -> Create New Key
# CONTEXT7_API_KEY=ctx7_XXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Tavily Search API Key (Riset Web Mendalam Khusus Agen AI)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'web-search', 'pero-problem-framing', 'systematic-debugging'.
# Peran SDLC: Rujukan garda ketiga (Tier-3) untuk riset pasar dan verifikasi web empiris.
# Kuota Gratis: 1.000 kueri pencarian per bulan gratis (tanpa kartu kredit).
# Cara Mendapatkan:
#   1. Buka https://tavily.com
#   2. Klik 'Get Started Free' / Sign In dengan Google/GitHub
#   3. Salin API Key dari Dashboard Overview (format: tvly-...)
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 3. Google Stitch API Key (Prototipe Antarmuka Visual & Ekstraksi Komponen)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'pero-uiux-design', 'subagent-driven-development'.
# Peran SDLC: Pembuatan sketsa wireframe dan prototipe UI visual interaktif.
# Akses: Gratis mengikuti status akun Google (Experimental Preview).
# Cara Mendapatkan:
#   1. Buka https://stitch.withgoogle.com
#   2. Sign In dengan akun Google pribadi Anda
#   3. Klik foto profil di pojok kanan atas -> Stitch Settings
#   4. Cari bagian 'API Key' -> klik 'Create an API key' dan salin kuncinya
# STITCH_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. OpenAlex Academic Research Catalog (Katalog Terbuka 250 Juta+ Publikasi Ilmiah)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'scientific-research', 'pero-problem-framing', 'pero-system-architecture', 'pero-quality-governance'.
# Peran SDLC: Rujukan garda utama (Tier-1) untuk validasi algoritma, kriptografi, dan konkurensi.
# Kuota & Akses: 100% Gratis dan ramah proyek personal/independen (tanpa syarat institusi/non-profit).
# Cara Mendapatkan:
#   - Cukup cantumkan email Anda di OPENALEX_MAILTO agar otomatis masuk ke 
#     "Polite Pool" OpenAlex (kecepatan hingga 10 kueri/detik, bebas biaya, stabil).
#   - Kunci API tambahan bersifat opsional, dapat dibuat di: https://openalex.org/settings/api
OPENALEX_MAILTO=developer@example.com
OPENALEX_API_KEY=

# ==============================================================================
# CATATAN PELADEN 100% LOKAL (TIDAK MEMERLUKAN KUNCI / BIAYA):
# - chrome-devtools: Berjalan via Chromium/Chrome lokal headless menggunakan Puppeteer.
# - graphify: Berjalan via CLI python lokal 'graphify' untuk menganalisis AST kode.
# ==============================================================================
