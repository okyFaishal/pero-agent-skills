# ==============================================================================
# Pero Agent Skills - Templat Konfigurasi Kunci API MCP (Opsional)
# ==============================================================================
# Salin berkas ini menjadi '.env' di root proyek Anda:
#   cp .env.pero.example .env
#
# PERHATIAN: Berkas '.env' Anda otomatis dilindungi oleh .gitignore dan skill
# 'env-guard' agar tidak pernah bocor ke commit git atau repositori publik.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Context7 Documentation API Key (Akses Dokumentasi Resmi Berkuota Pribadi)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'context-7', 'pero-system-architecture', 'pero-granular-refinement'.
# Kuota Gratis: 1.000 panggilan per bulan gratis.
# Dapatkan kunci di: https://context7.com/dashboard
# CONTEXT7_API_KEY=ctx7_XXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Brave Search API Key (Pencarian Web Cepat & Murah Hati)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'web-search', 'pero-prd-writing', 'find-skill'.
# Kuota Gratis: 2.000 kueri per bulan gratis.
# Dapatkan kunci di: https://brave.com/search/api
# BRAVE_API_KEY=BSAwXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 3. Tavily Search API Key (Riset Mendalam & Rangkuman Teks Bersih AI)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'web-search', 'pero-problem-framing', 'systematic-debugging'.
# Kuota Gratis: 1.000 kredit per bulan gratis.
# Dapatkan kunci di: https://tavily.com
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. Google Stitch API Key (Prototipe Antarmuka Visual & Ekstraksi Komponen)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'pero-uiux-design', 'subagent-driven-development'.
# Portal Layanan: https://stitch.withgoogle.com
# STITCH_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 5. Semantic Scholar API Key (Riset Naskah Ilmiah & Grafik Akademik Peer-Reviewed)
# ------------------------------------------------------------------------------
# Digunakan oleh: skill 'scientific-research', 'pero-system-architecture', 'pero-quality-governance'.
# Kuota Gratis: Server dapat berjalan tanpa API key (jeda 5s). Kunci pribadi memberikan laju cepat (jeda 2s) & kuota tinggi.
# Dapatkan kunci di: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=your_api_key_here
