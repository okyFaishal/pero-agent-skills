{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicPaperManifest",
  "type": "object",
  "required": ["version", "papers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id",
          "doi",
          "title",
          "authors",
          "year",
          "venue",
          "file_path",
          "sha256",
          "summary",
          "citation"
        ],
        "additionalProperties": false,
        "properties": {
          "paper_id": { "type": "string", "minLength": 1 },
          "doi": { "type": ["string", "null"], "pattern": "^(10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+|null)?$" },
          "title": { "type": "string", "minLength": 1 },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "venue": { "type": "string", "minLength": 1 },
          "file_path": { "type": "string", "pattern": "^docs/references/papers/.+\\.pdf$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 10 },
          "citation": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
